# Kopieren nach .env und anpassen.

# Benutzer/Gruppe, unter der beide Container laufen (TrueNAS: "apps" = 568).
# DATA_PATH und CONFIG_PATH müssen diesem Benutzer gehören.
PUID=568
PGID=568

# Speicherorte (TrueNAS: Pfade zu Datasets, z. B. /mnt/tank/apps/restic/...)
DATA_PATH=./data
CONFIG_PATH=./config

# Initialer Administrator (wird nur angelegt, wenn noch kein Admin existiert).
# Ohne ADMIN_PASSWORD wird ein zufälliges Passwort erzeugt und ins Log geschrieben.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Notfall: auf true setzen, Container neu starten -> Passwort von ADMIN_USERNAME
# wird auf ADMIN_PASSWORD zurückgesetzt. Danach wieder entfernen!
# RESET_ADMIN_PASSWORD=true

# Adresse, unter der restic-Clients das Gateway erreichen (nur für die
# Anzeige der Repository-URLs in der Oberfläche). Bei aktivem TLS wird daraus
# automatisch https://<Domain aus dem Zertifikat>:<GATEWAY_TLS_PORT>.
PUBLIC_URL=http://truenas.local:8000

# Veröffentlichte Ports (Host). Ohne TLS sind nur die HTTP-Ports offen, mit TLS
# nur die HTTPS-Ports (die Oberfläche leitet von HTTP auf HTTPS um).
GATEWAY_PORT=8000
GATEWAY_TLS_PORT=8444
UI_PORT=8080
UI_TLS_PORT=8443

# Nur nötig, wenn ein Reverse Proxy TLS terminiert. Bei TLS im Container
# (Let's Encrypt, Einstellung in der Oberfläche unter "TLS") wird das Cookie automatisch Secure.
COOKIE_SECURE=false

# Jede restic-Anfrage loggen (nützlich zur Fehlersuche)
LOG_REQUESTS=false

# Weitere rest-server-Optionen, z. B. "--max-size 1099511627776 --log -"
REST_SERVER_EXTRA_OPTIONS=

# Fertiges Image statt lokalem Build, z. B. ghcr.io/<user>/restic-server-ui:latest
# UI_IMAGE=restic-server-ui:latest
